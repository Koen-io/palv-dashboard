{
  "name": "p-alv-dashboard",
  "productName": "P-ALV Dashboard",
  "version": "1.40.0",
  "description": "Aanpasbaar operationeel dashboard voor de Police Air Support Unit",
  "author": "P-ALV",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Koen-io/palv-dashboard.git"
  },
  "palv": {
    "updateRepo": "Koen-io/palv-dashboard",
    "macElectron": "43.8.7"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint src test scripts",
    "check": "npm run lint && npm test",
    "predist": "npm run check && node scripts/haal-tor.js",
    "dist": "electron-builder --win nsis",
    "predist:mac": "npm run check",
    "dist:mac": "node scripts/build-mac.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@electron/get": "^2.0.3",
    "@eslint/js": "^9.39.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "leaflet": "^1.9.4",
    "plist": "^3.1.1",
    "yauzl": "^2.10.0"
  },
  "build": {
    "appId": "nl.palv.dashboard",
    "productName": "P-ALV Dashboard",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "P-ALV Dashboard",
      "artifactName": "P-ALV-Dashboard-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "build/tor",
        "to": "tor"
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "tldts": "^7.4.19"
  }
}
